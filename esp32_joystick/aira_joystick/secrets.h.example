// Copy this file to secrets.h (same folder) and fill it in. secrets.h is git-ignored: never commit it.

// Your phone hotspot (or home Wi-Fi). The ESP32 only works on 2.4 GHz: on Xiaomi / Redmi phones set
// Hotspot > AP band (or "Extend compatibility") to 2.4 GHz.
#define AIRA_WIFI_SSID     "your-hotspot-name"
#define AIRA_WIFI_PASSWORD "your-hotspot-password"

// On AIRA run:  python3 -m aira_pi controller   and copy the token it prints here.
#define AIRA_TOKEN         "PASTE-TOKEN"

// Stage 1 test: 1 = only print joystick events in the Serial Monitor (115200 baud), no Wi-Fi.
#define AIRA_SERIAL_ONLY   0

// Optional: the Pi's address if its announcements do not reach the ESP32. Leave "" normally.
#define AIRA_PI_HOST       ""
