# AIRA laptop server configuration. Copy to .env (scripts/generate_api_key.py does this).
# Never commit .env.

# --- Security ---------------------------------------------------------------
# 32+ random characters. Generate with: python scripts/generate_api_key.py
AIRA_API_KEY=
# Keep 127.0.0.1 until Phase 6 (Pi link). LAN binding also needs AIRA_ALLOW_LAN=true.
AIRA_HOST=127.0.0.1
AIRA_PORT=8765
AIRA_ALLOW_LAN=false
AIRA_LOG_CONVERSATION_CONTENT=false

# --- Model ------------------------------------------------------------------
AIRA_OLLAMA_BASE_URL=http://127.0.0.1:11434
# Start with E4B QAT (fits in 8 GB VRAM). Compare 12B with scripts/benchmark_llm.py.
AIRA_LLM_MODEL=gemma4:e4b-it-qat
AIRA_LLM_NUM_CTX=4096
AIRA_LLM_MAX_TOKENS=400
AIRA_LLM_TEMPERATURE=0.7
AIRA_LLM_KEEP_ALIVE=30m
# Leave unset for the model default. "false" lowers latency on models that reason before answering.
# AIRA_LLM_THINK=false

# --- Personality --------------------------------------------------------------
AIRA_USER_NAME=
# tamil = Tamil words in Tamil script (best for TTS) | latin = Tanglish in English letters
AIRA_TAMIL_OUTPUT_SCRIPT=tamil
# AIRA_PERSONA_FILE=config/persona.txt

# --- Voice (Phase 2 bake-off) ---------------------------------------------------
# Azure AI Speech resource key and region (Azure portal > Speech service > Keys and Endpoint).
AIRA_AZURE_SPEECH_KEY=
AIRA_AZURE_SPEECH_REGION=centralindia
AIRA_TTS_TA_VOICE=ta-IN-PallaviNeural
AIRA_TTS_EN_VOICE=en-IN-NeerjaNeural

# --- Web voice interface (HOW-TO-RUN.md) --------------------------------------
AIRA_WEB_UI_ENABLED=true
# Phones/other devices: AIRA_HOST=0.0.0.0 + AIRA_ALLOW_LAN=true + HTTPS (scripts/make_dev_cert.py)
# AIRA_SSL_CERTFILE=certs/aira-dev.crt
# AIRA_SSL_KEYFILE=certs/aira-dev.key
# Speech recognition on the laptop: auto = faster-whisper if installed, else the browser does it
AIRA_STT_PROVIDER=auto
AIRA_STT_MODEL=large-v3-turbo
AIRA_STT_DEVICE=auto
AIRA_STT_COMPUTE_TYPE=default
# AIRA's voice on the laptop: auto = Azure if a key is set, else Piper if a model is set, else the browser
AIRA_TTS_PROVIDER=auto
# AIRA_TTS_PIPER_MODEL=models/piper/ta_IN-rasa_female-medium.onnx
AIRA_TTS_RATE=1.1
AIRA_TTS_PITCH_PCT=5
AIRA_TTS_STRATEGY=auto

AIRA_LOG_LEVEL=INFO
