# AIRA laptop server settings. Copy to .env (scripts/generate_api_key.py does this). Never commit .env.
# Every setting, with what it does: docs/CONFIGURATION.md
#
#   1. Security and network     4. Voice (what AIRA sounds like)
#   2. AI brain: local / online  5. Task automation
#   3. Personality               6. Raspberry Pi and other devices

# ============================================================ 1. Security and network
# 32+ random characters. Generate with: python scripts/generate_api_key.py
AIRA_API_KEY=
# 127.0.0.1 = this laptop only. Phone / Raspberry Pi: AIRA_HOST=0.0.0.0, AIRA_ALLOW_LAN=true and HTTPS
# (python scripts\make_dev_cert.py, then the two SSL lines). .\scripts\connect_pi.ps1 checks all of it.
AIRA_HOST=127.0.0.1
AIRA_PORT=8765
AIRA_ALLOW_LAN=false
# AIRA_SSL_CERTFILE=certs/aira-dev.crt
# AIRA_SSL_KEYFILE=certs/aira-dev.key
AIRA_LOG_CONVERSATION_CONTENT=false
AIRA_LOG_LEVEL=INFO

# ============================================================ 2. AI brain: local / online
# ollama = the local model on this laptop (private, free, works offline)
# online = an online AI with your API key (no GPU needed; what you say is sent to that company)
# auto   = local first; the online AI answers whenever Ollama is not running
AIRA_LLM_PROVIDER=ollama

# --- Local (Ollama) ---
AIRA_OLLAMA_BASE_URL=http://127.0.0.1:11434
# qwen3.5:9b: best at task automation on the RTX 4060 (about 40 tokens/s). gemma4:e4b-it-qat: strongest
# Tamil, lighter. Compare on your laptop: python scripts\benchmark_llm.py (HOW-TO-RUN.md section 2b).
AIRA_LLM_MODEL=qwen3.5:9b
AIRA_LLM_NUM_CTX=4096
AIRA_LLM_MAX_TOKENS=400
AIRA_LLM_TEMPERATURE=0.7
# -1: model stays loaded while AIRA runs (no reload delay; freed when AIRA stops). 30m frees the GPU sooner.
AIRA_LLM_KEEP_ALIVE=-1
# Hidden "thinking" before each reply. false = fast replies for voice; true = slower, more careful.
AIRA_LLM_THINK=false

# --- Online (any OpenAI-compatible API) ---
# Service: openai, gemini, groq, openrouter, deepseek, mistral, together, anthropic
# (or leave it empty and set AIRA_ONLINE_BASE_URL, e.g. LM Studio http://localhost:1234/v1).
AIRA_ONLINE_SERVICE=
# AIRA_ONLINE_BASE_URL=
# The model name exactly as your service lists it (they change often; check the service's model page).
AIRA_ONLINE_MODEL=
# Your API key / token. Kept only in this file; never logged or shown.
AIRA_ONLINE_API_KEY=
AIRA_ONLINE_TIMEOUT_S=60

# ============================================================ 3. Personality
AIRA_USER_NAME=
# tamil = Tamil words in Tamil script (best for the voices) | latin = Tanglish in English letters
AIRA_TAMIL_OUTPUT_SCRIPT=tamil
# AIRA_PERSONA_FILE=config/persona.txt

# ============================================================ 4. Voice
# default | girl (sweet young girl, about 12). Preview: python scripts\voice_preview.py
AIRA_TTS_VOICE_STYLE=girl
# auto = Azure when a key is set, offline Piper (voices/ folder) as automatic backup; piper; azure; none
AIRA_TTS_PROVIDER=auto
# Offline voices: python scripts\download_voices.py fills voices/. Other files:
# AIRA_TTS_PIPER_EN_MODEL=voices/en_US-lessac-medium.onnx
# AIRA_TTS_PIPER_TA_MODEL=voices/ta_IN-rasa_female-medium.onnx
# Girl voice, offline: pitch raise (3.5 = the chosen voice A; 4.5 / 5.5 sound younger) and speed.
# AIRA_TTS_GIRL_PIPER_SEMITONES=3.5
# AIRA_TTS_GIRL_RATE=1.06               # 1.0 = a little slower
# wsola = voice A (keeps the speaking speed); native = experimental, speaks faster
# AIRA_TTS_PIPER_PITCH_METHOD=wsola
# Azure neural voices (optional; Azure portal > Speech service > Keys and Endpoint)
AIRA_AZURE_SPEECH_KEY=
AIRA_AZURE_SPEECH_REGION=centralindia
AIRA_TTS_TA_VOICE=ta-IN-PallaviNeural
AIRA_TTS_EN_VOICE=en-IN-NeerjaNeural
# AIRA_TTS_GIRL_TA_PITCH_PCT=18
AIRA_TTS_AZURE_TIMEOUT_S=4
AIRA_TTS_RATE=1.1
AIRA_TTS_PITCH_PCT=5
AIRA_TTS_STRATEGY=auto
# Speech recognition on the laptop: auto = faster-whisper if installed, else the browser does it
AIRA_STT_PROVIDER=auto
AIRA_STT_MODEL=large-v3-turbo
AIRA_STT_DEVICE=auto
AIRA_STT_COMPUTE_TYPE=default
AIRA_WEB_UI_ENABLED=true

# ============================================================ 5. Task automation (HOW-TO-RUN.md 2c)
AIRA_AGENT_ENABLED=true
# true = only log actions (default on non-Windows machines)
# AIRA_AGENT_DRY_RUN=true
AIRA_AGENT_FAST_COMMANDS=true
# Extra apps/websites: copy config/apps.example.json to config/apps.json
# AIRA_AGENT_APPS_FILE=config/apps.json

# ============================================================ 6. Raspberry Pi and other devices
# With AIRA_ALLOW_LAN=true the server announces itself on UDP 8766 so the Pi finds it.
AIRA_DEVICE_DISCOVERY=true
